# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Every value the pipeline uses is declared here;
# there are no hardcoded connection strings, paths or tuning values in the code.
# Docker Compose reads this same file, so credentials are defined once.
# ---------------------------------------------------------------------------

# --- Target website -------------------------------------------------------
WRC_BASE_URL=https://www.workplacerelations.ie
WRC_SEARCH_PATH=/en/search/
# The site's result pages are fixed at 10 items; used to compute the page count.
WRC_PAGE_SIZE=10
WRC_BODIES=employment_appeals_tribunal,equality_tribunal,labour_court,workplace_relations_commission
WRC_DATE_FORMAT_SITE=%d/%m/%Y

# --- Run defaults (CLI arguments / Dagster run config override these) -----
WRC_START_DATE=2024-01-01
WRC_END_DATE=2024-03-31
# monthly | weekly | daily | <N>d  (e.g. 10d)
WRC_PARTITION=monthly
# hash       = fetch every document and compare hashes (detects edits, default)
# skip_known = skip documents whose identifier is already stored (fast incremental)
WRC_REFRESH_POLICY=hash
# Older Employment Appeals Tribunal case pages hold no decision text, only a link
# to the PDF that does. true follows that link and stores the file.
WRC_FOLLOW_ATTACHMENTS=true

# --- Scrapy tuning (values measured against the live site) ----------------
# A crawler should identify itself and offer a way to be contacted. Add a contact
# address here if you run this against the live site regularly.
WRC_USER_AGENT=wrc-scrapy-pipeline/1.0 (+https://github.com/charbeld/wrc-scrapy-pipeline)
WRC_CONCURRENT_REQUESTS=16
WRC_CONCURRENT_REQUESTS_PER_DOMAIN=8
# Listing pages are server-side searches and degrade badly above ~8 in parallel.
WRC_LISTING_CONCURRENCY=8
WRC_DOWNLOAD_DELAY=0.25
WRC_AUTOTHROTTLE_ENABLED=true
WRC_AUTOTHROTTLE_START_DELAY=0.5
WRC_AUTOTHROTTLE_MAX_DELAY=10
WRC_AUTOTHROTTLE_TARGET_CONCURRENCY=6
WRC_RETRY_TIMES=5
WRC_RETRY_HTTP_CODES=408,429,500,502,503,504,522,524
WRC_RETRY_BACKOFF_BASE=2
WRC_RETRY_BACKOFF_MAX=60
WRC_DOWNLOAD_TIMEOUT=90
WRC_ROBOTSTXT_OBEY=true
# Enable only while developing so the live site is not re-hit on every run.
WRC_HTTPCACHE_ENABLED=false
WRC_HTTPCACHE_EXPIRATION_SECS=86400

# --- MongoDB (metadata store) --------------------------------------------
WRC_MONGO_ROOT_USER=wrc
WRC_MONGO_ROOT_PASSWORD=wrc_password
WRC_MONGO_PORT=27017
WRC_MONGO_URI=mongodb://wrc:wrc_password@localhost:27017/?authSource=admin
WRC_MONGO_DB=wrc
WRC_MONGO_LANDING_COLLECTION=landing_documents
WRC_MONGO_TRANSFORMED_COLLECTION=transformed_documents
WRC_MONGO_FAILURES_COLLECTION=scrape_failures
WRC_MONGO_RUNS_COLLECTION=pipeline_runs
# Which date the transformation slices on: published_date | partition_date
WRC_TRANSFORM_DATE_FIELD=published_date

# --- Object storage (MinIO locally, any S3 in production) -----------------
WRC_S3_ENDPOINT=http://localhost:9000
WRC_S3_ACCESS_KEY=minioadmin
WRC_S3_SECRET_KEY=minioadmin
WRC_S3_REGION=us-east-1
WRC_S3_SECURE=false
WRC_S3_PORT=9000
WRC_S3_CONSOLE_PORT=9001
WRC_S3_LANDING_BUCKET=landing
WRC_S3_TRANSFORMED_BUCKET=transformed

# --- Logging --------------------------------------------------------------
WRC_LOG_LEVEL=INFO
WRC_LOG_DIR=./logs
WRC_LOG_JSON=true

# --- Orchestration --------------------------------------------------------
# How many (body, partition) units Dagster runs at the same time. Each unit is a
# Scrapy process with its own concurrency, so keep this small to stay polite.
WRC_DAGSTER_MAX_PARALLEL_UNITS=2

# Windows: force UTF-8 so JSON logs with non-ASCII party names never crash the console.
PYTHONUTF8=1
